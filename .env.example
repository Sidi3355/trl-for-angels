# Copy to .env and fill in. Never commit .env.
# Variable names are the ones TRL reads (think_reason_learn/llm/_spec.py at 3437d64).

# RRF generator (the think step) and the app's research agent: Claude.
ANTHROPIC_API_KEY=

# Not used: Kev replaced Jev as the answerer (MASTER_PLAN section 0).
# TYPESAFE_API_KEY=

# Modal, for serving and fine-tuning Kev on a GPU (or run `modal token new` instead).
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Kev server's root URL (step A3), e.g. http://127.0.0.1:8009 or a Modal URL.
# TRL needs the full ".../v1/systemone" URL; research/checks/kev_endpoint.py adds it.
KEV_BASE_URL=
# Only if the Kev server was started with KEV_API_KEY set.
KEV_API_KEY=
