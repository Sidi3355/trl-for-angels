# Copy to .env and fill in. Never commit .env.
# Variable names are the ones TRL reads (think_reason_learn/llm/_spec.py at 3437d64).

# Jev, TypeSafe's System One decision model: TRL's answerer ("jev").
TYPESAFE_API_KEY=

# RRF generator (the think step). Set whichever provider is used.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Research agent in the app (Claude API with web search). Same key as above if Anthropic is the generator.
# ANTHROPIC_API_KEY=

# Modal, for serving and fine-tuning Kev on a GPU (or run `modal token new` instead).
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Kev server's base URL once it's deployed (step A3), e.g. http://127.0.0.1:8009 or a Modal URL.
KEV_BASE_URL=
