# Copy to app/backend/.env for local dev, or set these in the host's dashboard (Railway).
# Never commit real values. Every setting is optional: the defaults run fully on mocks.

ENV=dev

# --- Mock-to-real switches (one setting each) -------------------------------------------
# Research artefacts: app/contract/mocks until the research session publishes shared/artifacts
ARTIFACTS_DIR=app/contract/mocks
# Research agent: mock | claude (task 3; needs ANTHROPIC_API_KEY)
AGENT=mock
# Answerer: mock | jev (needs TYPESAFE_API_KEY)
ANSWERER=mock
# Decider: mock | kev (endpoint comes from model.json; KEV_API_KEY only if model.json says it needs one)
DECIDER=mock

# --- Keys -----------------------------------------------------------------------------------
# Claude API, for the research agent
ANTHROPIC_API_KEY=
# TypeSafe, for Jev
TYPESAFE_API_KEY=
# Production Kev endpoint, if protected
KEV_API_KEY=
# ElevenLabs, for the voice features (MASTER_PLAN 8b)
ELEVENLABS_API_KEY=
# Web push (task 5): generate a VAPID key pair; the subject is a mailto: or https: contact
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Research agent (task 3) ----------------------------------------------------------------
AGENT_MODEL=claude-opus-5-5
AGENT_MAX_SEARCHES=15

# --- Service --------------------------------------------------------------------------------
# Comma-separated frontend origins; the regex allows Vercel preview URLs
CORS_ORIGINS=http://localhost:3000
CORS_ORIGIN_REGEX=
# If set, every /v1 request needs the header X-Access-Token (or ?access_token= for event streams)
ACCESS_TOKEN=
# Jobs, memos and batches live in memory only, and expire this many minutes after finishing
RETENTION_MINUTES=120
MAX_CONCURRENT_SCREENINGS=4
BATCH_MAX_CONCURRENCY=3
# Scales the mock agent's simulated delays (0 = instant)
MOCK_PACE=1.0
# Check every response against the contract schemas
VALIDATE_RESPONSES=true
