# Copy to app/backend/.env for local dev, or set these in the host's dashboard (Railway).
# Never commit real values. Every setting is optional: the defaults run fully on mocks.

ENV=dev

# --- Mock-to-real switches (one setting each) -------------------------------------------
# Research artefacts: app/contract/mocks until the research session publishes shared/artifacts
ARTIFACTS_DIR=app/contract/mocks
# Research agent: mock | claude (needs the Anthropic key below)
AGENT=mock
# Answerer: mock | jev (needs TYPESAFE_API_KEY)
ANSWERER=mock
# Decider: mock | kev (endpoint comes from model.json; KEV_API_KEY only if model.json says it needs one)
DECIDER=mock

# --- Keys -----------------------------------------------------------------------------------
# Claude API, for the research agent. On a host (Railway) either name works. In the Claude Code
# cloud sandbox use SCREENER_ANTHROPIC_API_KEY: Claude Code itself reads ANTHROPIC_API_KEY.
SCREENER_ANTHROPIC_API_KEY=
# TypeSafe, for Jev
TYPESAFE_API_KEY=
# Production Kev endpoint, if protected
KEV_API_KEY=
# ElevenLabs, for the voice features (MASTER_PLAN 8b)
ELEVENLABS_API_KEY=
# Web push (task 5): generate a VAPID key pair; the subject is a mailto: or https: contact
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Research agent (AGENT=claude) -----------------------------------------------------------
AGENT_MODEL=claude-opus-5-5
# Always the public API; never the sandbox's own ANTHROPIC_BASE_URL
AGENT_BASE_URL=https://api.anthropic.com
AGENT_EFFORT=medium
AGENT_MAX_TOKENS=16000
AGENT_MAX_SEARCHES=10
# 0 leaves web fetch out. Needed in the Claude Code cloud sandbox: the API refuses web fetch from
# restricted-network sandboxes. Hosts such as Railway keep it on.
AGENT_MAX_FETCHES=5
# Values the agent is less sure of than this become "unknown"
AGENT_MIN_CONFIDENCE=0.5
# Spend caps in USD: research for one founder stops at the first; all research stops at the second.
# Also set a spend limit on the key's workspace in the Claude Console: that is the hard cap.
AGENT_MAX_COST_PER_FOUNDER_USD=1.0
AGENT_BUDGET_USD=5.0

# --- Service --------------------------------------------------------------------------------
# Comma-separated frontend origins; the regex allows Vercel preview URLs
CORS_ORIGINS=http://localhost:3000
CORS_ORIGIN_REGEX=
# If set, every /v1 request needs the header X-Access-Token (or ?access_token= for event streams)
ACCESS_TOKEN=
# Jobs, memos and batches live in memory only, and expire this many minutes after finishing
RETENTION_MINUTES=120
MAX_CONCURRENT_SCREENINGS=4
BATCH_MAX_CONCURRENCY=3
# Scales the mock agent's simulated delays (0 = instant)
MOCK_PACE=1.0
# Check every response against the contract schemas
VALIDATE_RESPONSES=true
