{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "What-if request",
  "description": "POST /v1/memos/{memo_id}/what-if. Re-runs only the decider with some inputs changed; no new research. Answer changes need only a Kev call. Field changes re-render the profile and, in answers mode, need new answerer calls.",
  "$defs": {
    "answer_change": {
      "type": "object",
      "required": ["kind", "rule_id", "value"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "answer" },
        "rule_id": { "$ref": "common.schema.json#/$defs/id" },
        "value": { "enum": ["yes", "no"] }
      }
    },
    "field_change": {
      "type": "object",
      "required": ["kind", "key", "value"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "field" },
        "key": { "$ref": "common.schema.json#/$defs/field_key" },
        "value": true
      },
      "allOf": [
        { "if": { "properties": { "key": { "const": "industry" } } }, "then": { "properties": { "value": { "$ref": "common.schema.json#/$defs/industry" } } } },
        { "if": { "properties": { "key": { "const": "cofounders" } } }, "then": { "properties": { "value": { "$ref": "common.schema.json#/$defs/cofounders" } } } },
        { "if": { "properties": { "key": { "const": "background" } } }, "then": { "properties": { "value": { "$ref": "common.schema.json#/$defs/background" } } } },
        { "if": { "properties": { "key": { "const": "work_experience" } } }, "then": { "properties": { "value": { "$ref": "common.schema.json#/$defs/work_experience" } } } },
        { "if": { "properties": { "key": { "const": "industry_experience" } } }, "then": { "properties": { "value": { "$ref": "common.schema.json#/$defs/industry_experience" } } } },
        { "if": { "properties": { "key": { "const": "education" } } }, "then": { "properties": { "value": { "$ref": "common.schema.json#/$defs/education" } } } },
        { "if": { "properties": { "key": { "const": "jobs" } } }, "then": { "properties": { "value": { "$ref": "common.schema.json#/$defs/jobs" } } } },
        { "if": { "properties": { "key": { "const": "prior_startups" } } }, "then": { "properties": { "value": { "$ref": "common.schema.json#/$defs/prior_startups" } } } },
        { "if": { "properties": { "key": { "const": "prior_exits" } } }, "then": { "properties": { "value": { "$ref": "common.schema.json#/$defs/prior_exits" } } } }
      ]
    }
  },
  "type": "object",
  "required": ["schema_version", "changes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "oneOf": [{ "$ref": "#/$defs/answer_change" }, { "$ref": "#/$defs/field_change" }] }
    },
    "policy": {
      "description": "Controls for the returned verdict. Defaults to the memo's policy.",
      "$ref": "common.schema.json#/$defs/policy_request"
    }
  }
}
